rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Zero-Trust validation
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email.matches('.*@forexnews\\.app$')
      );
    }

    function isValidDateDoc(docId) {
      return docId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Rules for daily trader polls
    match /daily_polls/{dateId} {
      // 1. Read: Publicly readable for all app users
      allow read: if isValidDateDoc(dateId);

      // 2. Create / Delete: Admin / Service Account only
      allow create: if isAdmin() && isValidDateDoc(dateId)
        && request.resource.data.keys().hasAll(['id', 'question', 'asset', 'closingTime', 'date', 'totalVotes', 'options'])
        && request.resource.data.question is string
        && request.resource.data.question.size() <= 300
        && request.resource.data.totalVotes == 0
        && request.resource.data.options is list
        && request.resource.data.options.size() >= 2
        && request.resource.data.options.size() <= 4;

      allow delete: if isAdmin();

      // 3. Update (Voting): Strict Zero-Trust vote increment / transfer validation
      allow update: if isValidDateDoc(dateId) && (
        // Case A: Admin can edit anything
        isAdmin() ||
        // Case B: Public user voting - can increment new vote OR switch vote without tampering metadata
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['options', 'totalVotes'])
          && request.resource.data.question == resource.data.question
          && request.resource.data.asset == resource.data.asset
          && request.resource.data.date == resource.data.date
          && (
            request.resource.data.totalVotes == resource.data.totalVotes + 1 ||
            request.resource.data.totalVotes == resource.data.totalVotes
          )
          && request.resource.data.options.size() == resource.data.options.size()
        )
      );
    }

    // Rules for quick trade polls (app-level symbol polls e.g. 2026-09-19_XAUUSD)
    match /quick_trade_polls/{pollId} {
      // 1. Read: Publicly readable for all app users
      allow read: if true;

      // 2. Create / Update (Voting): Allow users to initialize polls and submit/switch votes
      allow create, update: if true;

      // 3. Delete: Admin only
      allow delete: if isAdmin();
    }

    // User profiles
    // Protected billing fields — can ONLY be updated by the Cloudflare Webhook
    // (Firebase service account) or by a server-side admin call.
    // Regular authenticated users can update non-billing profile fields only.
    function isBillingField(fieldPath) {
      return fieldPath in [
        'isPro', 'expirationDate', 'planType', 'proPlan', 'subscriptionType',
        'paymentGateway', 'subscriptionStatus', 'autoPay', 'subscriptionId',
        'paymentId', 'hasTrial', 'trialEndsAt', 'lastRenewedAt', 'cancelledAt',
        'proUpdatedAt'
      ];
    }

    match /users/{userId} {
      // Anyone authenticated can read their own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // Admin / Service Account can write anything (webhook uses service account)
      allow write: if isAdmin();

      // Authenticated users can create, update, and delete their own profile
      allow create, update, delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Block all other unauthorized root collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
